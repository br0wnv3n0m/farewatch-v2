{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs plus the bundled flight engine only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/farewatch-engine", "sidecar": true, "args": ["lookup", "--watch-stdin"] }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/farewatch-engine", "sidecar": true, "args": ["selftest"] }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
